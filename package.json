{
  "name": "shift-vps-transfer",
  "version": "1.0.0",
  "description": "Move projects from an old VPS to a new VPS",
  "main": "server/index.js",
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "dev": "vite --config web/vite.config.js",
    "prestart": "node -e \"require('fs').existsSync('web/dist/index.html')||process.exit(1)\" || npm run build"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
